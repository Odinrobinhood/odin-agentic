[Unit]
Description=Odin Agentic backtest worker
After=network-online.target postgresql.service odin-signer.service odin-market.service
Wants=network-online.target
# needs the LLM credential; provision.sh only enables this unit once it exists
# starts when at least one LLM credential exists (| = any of these)
ConditionPathExists=|/etc/odin/secrets/anthropic.env
ConditionPathExists=|/etc/odin/secrets/openrouter.env

[Service]
Type=simple
User=odin
Group=odin
EnvironmentFile=/etc/odin/chain.env
EnvironmentFile=-/etc/odin/secrets/anthropic.env
EnvironmentFile=-/etc/odin/secrets/openrouter.env
EnvironmentFile=-/etc/odin/llm.env
EnvironmentFile=-/etc/odin/build.env
WorkingDirectory=/opt/odin/app
ExecStart=/usr/bin/node packages/backtest/src/main.ts
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
