# Public entry point (architecture §6): TLS via Let's Encrypt, only the web app (BFF) is exposed.
# The API, signer and every service stay on loopback; the BFF talks to the API on 127.0.0.1:7500.
# Caddy replaces any client-sent X-Forwarded-For with the real client IP (no trusted_proxies), which the
# BFF forwards to the API for per-client rate limits.
odinrobinhood.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/odin-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

www.odinrobinhood.com {
	redir https://odinrobinhood.com{uri} permanent
}
