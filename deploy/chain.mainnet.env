# Non-secret chain config for application processes (runtime, guard watcher, executor, risk engine)
# on Robinhood Chain mainnet (4663). Router/WETH/USDG must match deploy/signer.mainnet.env.
# Verified 2026-11-09:
#   QuoterV2: developers.uniswap.org Robinhood Chain deployments; quoter.factory() and quoter.WETH9()
#             read on-chain match the pinned factory/WETH; live quote 0.01 WETH -> 21.0 USDG via fee 500.
#   Chainlink feeds (verified 2026-11-10): deploy/chainlink.mainnet.json, generated and checked on-chain by
#             packages/risk/scripts/chainlink-feeds.ts. Never add a feed by hand.
CHAIN_ID=4663
CHAIN_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood.drpc.org
CHAIN_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2
CHAIN_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
CHAIN_QUOTER_V2=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
CHAIN_WETH=0x0bd7d308f8e1639fab988df18a8011f41eacad73
CHAIN_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
CHAINLINK_FEEDS_FILE=/etc/odin/chainlink.json

EXECUTOR_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood.drpc.org
EXECUTOR_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2
EXECUTOR_MAX_FEE_PER_GAS_WEI=1000000000
SIGNER_AGENT_URL=http://127.0.0.1:7401
SIGNER_AGENT_TOKEN_FILE=/etc/odin/secrets/signer-agent.token
# guard watcher only (file readable by odin-guard, not by odin)
SIGNER_GUARD_URL=http://127.0.0.1:7402
SIGNER_GUARD_TOKEN_FILE=/etc/odin/secrets/signer-guard.token
