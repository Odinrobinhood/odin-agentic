[Unit]
Description=Odin Agentic signer (isolated)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=odin-signer
Group=odin-signer
EnvironmentFile=/etc/odin/signer.env
EnvironmentFile=-/etc/odin/build.env
WorkingDirectory=/opt/odin/app
ExecStart=/usr/bin/node packages/signer/src/main.ts
Restart=on-failure
RestartSec=5

# hardening (architecture §9)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
