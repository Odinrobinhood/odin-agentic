# Non-secret signer configuration for Robinhood Chain mainnet (4663).
# Addresses verified 2026-11-09:
#   SwapRouter02 / UniswapV3Factory: developers.uniswap.org Robinhood Chain deployments; router.factory() read on-chain
#   WETH: router.WETH9() read on-chain
#   USDG: docs.paxos.com USDG mainnet table (Robinhood Mainnet)
SIGNER_CHAIN_ID=4663
SIGNER_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood.drpc.org
SIGNER_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2
SIGNER_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
# QuoterV2: same verified address as deploy/chain.mainnet.env (quoter.factory() == SIGNER_FACTORY, checked at preflight)
SIGNER_QUOTER_V2=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
# technical limit: amountOutMin at most this many bps below the signer's own quote
SIGNER_MAX_SLIPPAGE_BPS=5000
SIGNER_WETH=0x0bd7d308f8e1639fab988df18a8011f41eacad73
SIGNER_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
SIGNER_SEED_FILE=/var/lib/odin-signer/seed/master.seed
SIGNER_DATABASE_URL=postgresql://odin_signer@/odin?host=/var/run/postgresql
SIGNER_AGENT_LISTEN=127.0.0.1:7401
SIGNER_GUARD_LISTEN=127.0.0.1:7402
SIGNER_AGENT_TOKEN_FILE=/etc/odin/secrets/signer-agent.token
SIGNER_GUARD_TOKEN_FILE=/etc/odin/secrets/signer-guard.token
SIGNER_AGENT_DAILY_CAP=200
SIGNER_GUARD_DAILY_CAP_FLOOR=30
SIGNER_DEADLINE_SECONDS=60
SIGNER_MAX_GAS_LIMIT=5000000
SIGNER_MAX_FEE_PER_GAS_WEI=1000000000
