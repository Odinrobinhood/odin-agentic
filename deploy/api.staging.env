# API service (staging). No public domain yet: the web app is reached through an SSH tunnel
# (ssh -L 3000:127.0.0.1:3000 ubuntu@<host>), so SIWE signs for localhost:3000.
# When a domain exists, set API_SIWE_DOMAIN/URI to it and put Caddy (TLS) in front (architecture §6).
API_LISTEN=127.0.0.1:7500
API_SIWE_DOMAIN=localhost:3000
API_SIWE_URI=http://localhost:3000
API_JWT_KEY_FILE=/etc/odin/secrets/api-jwt.key
