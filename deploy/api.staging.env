# API service (staging). No public domain yet: the API binds to loopback only and is not exposed.
# When a domain exists, set API_SIWE_DOMAIN/URI to it and put Caddy (TLS) in front (architecture §6).
API_LISTEN=127.0.0.1:7500
API_SIWE_DOMAIN=odin.staging.local
API_SIWE_URI=https://odin.staging.local
API_JWT_KEY_FILE=/etc/odin/secrets/api-jwt.key
