# API service. Public at https://odinrobinhood.com behind Caddy (deploy/Caddyfile, architecture §6);
# SIWE messages must name this domain. The API itself listens on loopback only.
API_LISTEN=127.0.0.1:7500
API_SIWE_DOMAIN=odinrobinhood.com
API_SIWE_URI=https://odinrobinhood.com
API_JWT_KEY_FILE=/etc/odin/secrets/api-jwt.key
