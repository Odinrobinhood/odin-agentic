# Non-secret LLM settings, installed once to /etc/odin/llm.env (provisioning never overwrites an existing copy).
# Keys live in /etc/odin/secrets/anthropic.env (ANTHROPIC_API_KEY=...) and /etc/odin/secrets/openrouter.env
# (OPENROUTER_API_KEY=...), mode 0440 root:odin.
#
# OpenRouter models users may pick, comma-separated OpenRouter model ids (copy them from openrouter.ai/models;
# pick models whose "supported parameters" include structured outputs). Empty = no OpenRouter models offered.
# Example format only: OPENROUTER_MODELS=vendor/model-a,vendor/model-b
OPENROUTER_MODELS=
# AI Market Analyst model (optional). Default: claude-sonnet-5-5 with an Anthropic key, otherwise the first
# OPENROUTER_MODELS entry. OpenRouter models are written with the prefix, e.g. openrouter/vendor/model-a.
# The model must support tool calling.
#ANALYST_MODEL=
# 1 = route only to zero-data-retention endpoints (fewer providers, stronger privacy)
OPENROUTER_ZDR=0
