[Unit]
Description=Odin Agentic chain indexer (Transfer + Swap events)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=odin
Group=odin
EnvironmentFile=/etc/odin/chain.env
Environment=INDEXER_LOOKBACK_BLOCKS=36000
WorkingDirectory=/opt/odin/app
ExecStart=/usr/bin/node packages/indexer/src/main.ts
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
